{
  "name": "crime-master-bingo",
  "productName": "Anthem Square",
  "version": "2.4.0",
  "description": "Anthem Square - offline music video bingo for live events",
  "main": "src/main/main.js",
  "author": "Anthem Square",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "node tools/make-sample-videos.js sample-videos 50 6 && xvfb-run -a node test/e2e/acceptance.js sample-videos",
    "make-samples": "node tools/make-sample-videos.js",
    "dist:win": "node tools/fetch-ffmpeg.js win32-x64 && electron-builder --win nsis portable --x64",
    "dist:dir": "node tools/fetch-ffmpeg.js win32-x64 && electron-builder --win dir --x64"
  },
  "build": {
    "appId": "com.crimemaster.bingo",
    "productName": "Anthem Square",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "vendor/ffmpeg/win32-x64",
          "to": "ffmpeg",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Anthem Square",
      "artifactName": "AnthemSquare-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "AnthemSquare-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "LICENSES",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "AudioVideo"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Coolrishi20",
        "repo": "Crime-Master-Bingo",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "ws": "^8.22.1",
    "yauzl": "^3.4.0",
    "yazl": "^2.5.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
