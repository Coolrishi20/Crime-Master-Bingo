{
  "name": "crime-master-bingo",
  "productName": "Crime Master Bingo",
  "version": "1.0.0",
  "description": "Crime Master Bingo - offline music video bingo for live events",
  "main": "src/main/main.js",
  "author": "Crime Master Bingo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/unit/",
    "test:e2e": "node test/e2e/run-e2e.js",
    "make-samples": "node tools/make-sample-videos.js",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:dir": "electron-builder --win dir --x64"
  },
  "build": {
    "appId": "com.crimemaster.bingo",
    "productName": "Crime Master Bingo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/fonts/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Crime Master Bingo",
      "artifactName": "CrimeMasterBingo-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CrimeMasterBingo-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
